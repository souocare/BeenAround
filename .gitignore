# ============================================================
# BeenAround — Root .gitignore
# ============================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Editors / IDEs
.idea/
.vscode/*
!.vscode/extensions.json
*.iml
*.swp
*.swo
*~

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
*.egg-info/
dist/
build/

# Python virtual environments
.venv/
venv/
env/
*venv/

# Environment / secrets
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key

# SQLite databases and journals
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal

# Runtime data
backend/data/*
!backend/data/.gitkeep
backend/logs/
*.log

# Local backups
backups/
*.bak
*.backup

# Flutter / Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
.flutter_tool_state
**/build/
coverage/

# Flutter generated local files
**/android/local.properties
**/android/key.properties
**/android/*.jks
**/android/*.keystore

# iOS / Xcode
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/ephemeral/
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/flutter_export_environment.sh
**/ios/ServiceDefinitions.json
**/*.xcuserstate
**/xcuserdata/

# Temporary files
*.tmp
*.temp
*.orig
*.rej

